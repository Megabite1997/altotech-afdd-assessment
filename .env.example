# Copy to .env before starting the stack:  cp .env.example .env

# --- stores -----------------------------------------------------------------
DATABASE_URL=postgresql://afdd:afdd@timescaledb:5432/afdd

# --- broker -----------------------------------------------------------------
KAFKA_BOOTSTRAP=redpanda:9092
TELEMETRY_TOPIC=telemetry.device.v1
CONSUMER_GROUP=afdd-ingest
TOPIC_PARTITIONS=6

# --- device simulator -------------------------------------------------------
# SIM_INTERVAL_SECONDS: publish cadence in seconds (15 or 60).
# SIM_SPEEDUP: source seconds per wall-clock second. 60 replays 6 hours in 6 minutes.
# SIM_BUILDINGS: "*" for all, or e.g. building-a,building-b
SOURCE_DIR=/srv/source-pack
SIM_INTERVAL_SECONDS=60
SIM_SPEEDUP=60
SIM_BUILDINGS=*
SIM_LOOP=false

# --- evaluator --------------------------------------------------------------
# EVAL_CLOCK=data  -> evaluation time is the newest observation time (reproducible replay)
# EVAL_CLOCK=wall  -> evaluation time is wall-clock now (live deployments)
EVAL_CLOCK=data
EVAL_TICK_SECONDS=5

# --- AI rule authoring ------------------------------------------------------
# Without a key the agent falls back to a deterministic stub provider and says so.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
AGENT_MAX_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=90

# --- api --------------------------------------------------------------------
API_CORS_ORIGINS=*
LOG_LEVEL=INFO
